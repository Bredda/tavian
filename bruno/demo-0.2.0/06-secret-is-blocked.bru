meta {
  name: 06 A secret is blocked by policy
  type: http
  seq: 7
}

post {
  url: {{dataUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{demoKey}}
}

body:json {
  {
    "model": "demo-chat",
    "max_tokens": 20,
    "messages": [
      { "role": "user", "content": "The key is AKIAIOSFODNN7EXAMPLE" }
    ]
  }
}

assert {
  res.status: eq 403
  res.body.error.code: eq blocked_by_policy
  res.body.error.message: contains SECRET_IN_PROMPT
}

docs {
  The demo policy `no-secrets` refuses the request (reason `SECRET_IN_PROMPT`).
}
