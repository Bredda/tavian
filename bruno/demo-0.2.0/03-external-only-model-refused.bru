meta {
  name: 03 The external-only model is refused
  type: http
  seq: 4
}

post {
  url: {{dataUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{financeKey}}
}

body:json {
  {
    "model": "demo-partner",
    "max_tokens": 20,
    "messages": [
      { "role": "user", "content": "Transfer 100 EUR to {{iban}}" }
    ]
  }
}

assert {
  res.status: eq 403
  res.body.error.code: eq no_eligible_backend
}

tests {
  test("the refusal has a decision id, in the header and in the body", function () {
    const id = res.getHeader("x-tavian-decision-id");
    expect(id).to.be.a("string").and.not.empty;
    expect(res.body.error.decision_id).to.equal(id);
  });
}

script:post-response {
  bru.setVar("refusedDecisionId", res.getHeader("x-tavian-decision-id"));
}

docs {
  `demo-partner` only exists at the external provider, which may not receive
  confidential data: no eligible backend. The refusal carries a decision id
  (header and `error.decision_id`, kept in `refusedDecisionId`) and the
  record says why:

  ```
  docker compose -f deploy/compose/docker-compose.yml exec postgres psql -U tavian -d tavian -Atc \
    "select payload->>'reason_code' from outbox where event_id='$DECISION_ID'"
  ```

  Expected: `NO_ELIGIBLE_BACKEND`.
}
